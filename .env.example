# Copy to .env.local and fill in the values.
OPENROUTER_API_KEY=
APP_URL=http://localhost:3000
# Optional: higher GitHub API limits for the project archive and admin list.
GITHUB_TOKEN=
# Optional: enables the unlisted /admin project config editor.
ADMIN_PASSWORD=

# --- Chat operations (see docs/chat-operations.md) ---
# Kill switch: "true" makes POST /api/chat return 503 before parsing or calling
# the provider. Useful during incidents without a redeploy.
CHAT_DISABLED=
# Fixed-window per-client rate limit. Window in milliseconds (default 60000)
# and max requests per window (default 20).
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
# TEST ONLY: "true" disables the rate limiter so local regression suites can run.
# Never set this in production.
CHAT_RATE_LIMIT_DISABLED=
# Optional: Upstash Redis REST for a global (multi-instance) rate limit.
# Without these the limiter is per serverless instance (documented caveat).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
